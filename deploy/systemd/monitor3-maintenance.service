[Unit]
Description=Monitor 3.0 Maintenance Worker
After=network.target

[Service]
Type=simple
User=monitor3
Group=monitor3
WorkingDirectory=/opt/monitor3
EnvironmentFile=/etc/monitor3/monitor3.env
ExecStart=/opt/monitor3/.venv/bin/monitor3-maintenance
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/monitor3

[Install]
WantedBy=multi-user.target

