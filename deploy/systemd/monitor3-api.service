[Unit]
Description=Monitor 3.0 API
After=network.target

[Service]
Type=simple
User=monitor3
Group=monitor3
WorkingDirectory=/opt/monitor3
EnvironmentFile=/etc/monitor3/monitor3.env
ExecStart=/opt/monitor3/.venv/bin/gunicorn --bind 127.0.0.1:5001 --workers 2 --threads 4 monitor.api.app:create_app()
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/monitor3

[Install]
WantedBy=multi-user.target
