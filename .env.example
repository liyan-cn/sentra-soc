# Docker Compose reads this file. Native Python does NOT auto-load .env.
MONITOR_CONFIG_PATH=/opt/monitor3/config/base.yaml
MONITOR_LOG_ROOT=./logs
MONITOR_DEVICE_ID=huawei-ips-01
MONITOR_VPN_DEVICE_ID=vpn-01
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MONITOR_ADMIN_TOKEN=
MONITOR_FIREWALL_PASSWORD=
MONITOR_WECHAT_WEBHOOK=
MONITOR_SMTP_PASSWORD=
MONITOR_WEBHOOK_URL=
MONITOR_WEBHOOK_SECRET=
# Required only when starting the optional monitoring profile.
GRAFANA_ADMIN_PASSWORD=
